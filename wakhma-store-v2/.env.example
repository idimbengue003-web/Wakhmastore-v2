# ═══════════════════════════════════════════════════
# Wakhma Store v2 - Variables d'environnement
# ═══════════════════════════════════════════════════

# Base de données PostgreSQL (obligatoire en production)
# Exemples :
#   - Vercel Postgres : postgres://default:xxxx@ep-xxx.us-east-1.aws.neon.tech/verceldb?sslmode=require
#   - Supabase        : postgresql://postgres:[password]@db.[project].supabase.co:5432/postgres
#   - Neon            : postgres://user:pass@ep-xxx.us-east-2.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=postgresql://user:password@localhost:5432/wakhmastore

# Clé secrète JWT (obligatoire en production)
# Génère avec : openssl rand -base64 32
JWT_SECRET=change-me-to-a-random-secret

# Admin WhatsApp (optionnel - pour les paiements via WhatsApp)
ADMIN_WHATSAPP=770000000

# SenePay (optionnel - pour les paiements en ligne)
SENEPAY_API_KEY=
SENEPAY_MERCHANT_ID=
SENEPAY_BASE_URL=https://api.senepay.com
